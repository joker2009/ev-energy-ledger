.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

.month-nav {
  width: 72rpx;
  height: 72rpx;
  line-height: 66rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--color-text);
  border-radius: 50%;
}

.month-nav.is-disabled {
  color: #c9cdd4;
}

.month-label {
  min-width: 220rpx;
  padding: 0 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.summary-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-border);
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.state-desc {
  margin-top: 12rpx;
  max-width: 560rpx;
  text-align: center;
}

.state-btn {
  margin-top: 40rpx;
}

.weekday-row {
  display: flex;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  padding: 12rpx 8rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.day-cell {
  width: 14.2857%;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.day-number {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 50%;
  font-variant-numeric: tabular-nums;
}

.is-outside .day-number {
  color: #c9cdd4;
}

.is-today .day-number {
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  line-height: 54rpx;
}

.is-selected .day-number {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.is-selected .day-dot {
  background: var(--color-primary);
}

.day-section {
  margin-top: 24rpx;
}

.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.day-title {
  font-size: 30rpx;
  font-weight: 600;
}

.day-summary {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.day-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--color-text-muted);
  background: var(--color-card);
  border-radius: 20rpx;
}

.record-card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.record-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-left {
  display: flex;
  align-items: center;
}

.type-tag {
  margin-right: 16rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.4;
  border-radius: 8rpx;
}

.type-home {
  color: #00a870;
  background: rgba(0, 168, 112, 0.1);
}

.type-fast {
  color: #ed7b2f;
  background: rgba(237, 123, 47, 0.12);
}

.type-swap {
  color: #0052d9;
  background: rgba(0, 82, 217, 0.1);
}

.type-none {
  color: var(--color-text-secondary);
  background: #f2f3f5;
}

.record-kwh {
  font-size: 30rpx;
  font-weight: 600;
}

.record-right {
  display: flex;
  align-items: center;
}

.record-fee {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.record-arrow {
  margin-left: 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-text-muted);
}

.record-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.record-metrics {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
