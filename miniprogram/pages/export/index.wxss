.intro {
  margin-bottom: 24rpx;
}

.intro-title {
  font-size: 30rpx;
  font-weight: 600;
}

.intro-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.scope-options {
  --td-spacer-2: 28rpx;
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.month-row-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.month-row-value {
  font-size: 28rpx;
  color: var(--color-text);
}

.submit-area t-button {
  display: block;
  width: 100%;
}

.submit-area .t-button {
  display: flex;
  width: 100% !important;
}

.result-card {
  margin-top: 28rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
}

.result-file {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.result-actions {
  display: flex;
  margin-top: 24rpx;
}

.result-actions t-button {
  margin-right: 20rpx;
}

.error-card {
  margin-top: 24rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #d54941;
  background: #fff5f5;
  border-radius: 16rpx;
}

.footnote {
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-muted);
}
