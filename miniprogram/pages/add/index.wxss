.add-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.state {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.form-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
}

.row-label {
  font-size: 30rpx;
}

.row-value {
  display: flex;
  align-items: center;
}

.row-arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-text-muted);
}

.form-block {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.block-label {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.input-wrap {
  padding: 8rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.scan-card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--color-primary-soft);
  border-radius: 20rpx;
}

.scan-icon {
  margin-right: 16rpx;
  font-size: 40rpx;
  line-height: 1;
}

.scan-body {
  flex: 1;
  min-width: 0;
}

.scan-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.scan-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
}

.scan-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: var(--color-primary);
}

.preview-card {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-card);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
}

.preview-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

.preview-body {
  margin-top: 16rpx;
}

.preview-gallery {
  display: flex;
}

.preview-thumb {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  margin-right: 14rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}

.preview-thumb:last-child {
  margin-right: 0;
}

.preview-fields {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.preview-field {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 3rpx 0;
  font-size: 22rpx;
}

.preview-label {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: var(--color-text-muted);
}

.preview-value {
  min-width: 0;
  text-align: right;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-empty {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.preview-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

.textarea-wrap {
  padding-top: 20rpx;
  padding-bottom: 24rpx;
}

.soc-row {
  display: flex;
  align-items: center;
}

.charge-options {
  --td-spacer-2: 12rpx;
}

.soc-cell {
  flex: 1;
  min-width: 0;
}

.soc-arrow {
  padding: 0 20rpx;
  font-size: 30rpx;
  color: var(--color-text-muted);
}

.block-error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d54941;
}

.tip-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--color-primary-soft);
  border-radius: 20rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.tip-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.submit-area {
  margin-top: 40rpx;
}

.submit-area t-button {
  display: block;
  width: 100%;
}

.submit-area .t-button {
  display: flex;
  width: 100% !important;
}
