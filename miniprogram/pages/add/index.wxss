.add-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.state {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.form-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
}

.row-label {
  font-size: 30rpx;
}

.row-value {
  display: flex;
  align-items: center;
}

.row-arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-text-muted);
}

.form-block {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.block-label {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.input-wrap {
  padding: 8rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.recognize-row {
  display: flex;
  justify-content: flex-end;
  padding: 0 0 14rpx;
}

.recognize-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

.textarea-wrap {
  padding-top: 20rpx;
  padding-bottom: 24rpx;
}

.soc-row {
  display: flex;
  align-items: center;
}

.charge-options {
  --td-spacer-2: 12rpx;
}

.soc-cell {
  flex: 1;
  min-width: 0;
}

.soc-arrow {
  padding: 0 20rpx;
  font-size: 30rpx;
  color: var(--color-text-muted);
}

.block-error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d54941;
}

.tip-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--color-primary-soft);
  border-radius: 20rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.tip-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.submit-area {
  margin-top: 40rpx;
}

.submit-area t-button {
  display: block;
  width: 100%;
}

.submit-area .t-button {
  display: flex;
  width: 100% !important;
}
