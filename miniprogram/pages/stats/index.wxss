.range-bar {
  display: flex;
  justify-content: flex-end;
  padding-bottom: 20rpx;
}

.range-option {
  margin-left: 12rpx;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #ffffff;
  border-radius: 28rpx;
}

.range-option.is-active {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.year-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 0 16rpx;
}

.year-nav {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text);
  border-radius: 50%;
}

.year-nav.is-disabled {
  color: #c9cdd4;
}

.year-label {
  min-width: 140rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.metric-card {
  display: flex;
  align-items: flex-start;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx 16rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.metric-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.metric-unit {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.metric-divider {
  width: 1rpx;
  height: 72rpx;
  background: var(--color-border);
}

.totals-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 24rpx 16rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.total-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-value {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.total-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-secondary);
}

.total-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-border);
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.state-desc {
  margin-top: 12rpx;
  max-width: 560rpx;
  text-align: center;
}

.state-btn {
  margin-top: 40rpx;
}

.chart-card {
  margin-top: 24rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 28rpx 24rpx 24rpx;
}

.chart-title {
  display: flex;
  align-items: baseline;
  font-size: 30rpx;
  font-weight: 600;
}

.chart-unit {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-muted);
}

.chart-body {
  width: 100%;
  height: 360rpx;
  margin-top: 16rpx;
}

.chart-body ec-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 72rpx 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
}

.empty-tip-title {
  font-size: 30rpx;
  font-weight: 600;
}

.empty-tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.empty-tip-btn {
  margin-top: 36rpx;
}

.footnote {
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-muted);
}
